# syntax=docker/dockerfile:1.7
ARG RUST_VERSION=1.98.0
ARG CARGO_CHEF_VERSION=0.1.76
ARG SCCACHE_VERSION=0.17.0
ARG SCCACHE_SHA256=affec995429df5f97498e93d373b10733b0048a6391554c83ccd57d9b6c23d1c
FROM rust:${RUST_VERSION}-bookworm AS tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang lld mold pkg-config ca-certificates git cmake ninja-build && \
    rm -rf /var/lib/apt/lists/*
RUN cargo install --locked cargo-chef --version ${CARGO_CHEF_VERSION} && \
    cargo install --locked cargo-machete --version 0.9.2
RUN curl -fsSL -o /tmp/sccache.tgz \
      https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-dist-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz && \
    echo "${SCCACHE_SHA256}  /tmp/sccache.tgz" | sha256sum -c - && \
    tar -xzf /tmp/sccache.tgz -C /tmp && \
    install -m 0755 /tmp/sccache-dist-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache /usr/local/bin/sccache && \
    rm -rf /tmp/sccache*
WORKDIR /workspace/native

FROM tools AS planner
COPY native/Cargo.toml ./Cargo.toml
COPY native/crates ./crates
COPY native/Cargo.lock ./Cargo.lock
RUN cargo chef prepare --recipe-path /tmp/recipe.json

FROM tools AS deps
COPY --from=planner /tmp/recipe.json /tmp/recipe.json
RUN --mount=type=cache,id=graphvis-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=graphvis-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=graphvis-cargo-target,target=/workspace/.cache/cargo-target \
    CARGO_TARGET_DIR=/workspace/.cache/cargo-target \
    cargo chef cook --release --recipe-path /tmp/recipe.json

FROM deps AS dev
WORKDIR /workspace
COPY . .
ENV CARGO_TARGET_DIR=/workspace/.cache/cargo-target \
    RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/workspace/.cache/sccache
# sccache is installed from a distro/package layer where available by devcontainer;
# if absent, scripts/fast-env.sh removes RUSTC_WRAPPER safely.
ENTRYPOINT ["/bin/bash"]
